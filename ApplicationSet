apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: shopping-app
  namespace: argocd
spec:
  project: default

  source:
    repoURL: https://github.com/Shoaibkhans700/shopping-app-k8.git
    targetRevision: main
    path: k8s

  destination:
    server: https://kubernetes.default.svc
    namespace: shopping-app

  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
